# Contributor: Hosam Hani <76218642+s0sta@users.noreply.github.com>
# Maintainer: Hosam Hani <76218642+s0sta@users.noreply.github.com>
pkgname=nabd
pkgver=0.1.0
pkgrel=0
pkgdesc="Doctor for Linux servers: finds problems, explains them and gives the fix"
url="https://github.com/s0sta/nabd"
arch="all"
license="MIT"
makedepends="go"
subpackages="
	$pkgname-doc
	$pkgname-bash-completion
	$pkgname-zsh-completion
	$pkgname-fish-completion
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/s0sta/nabd/archive/refs/tags/v$pkgver.tar.gz"

export GOCACHE="${GOCACHE:-"$srcdir/go-cache"}"
export GOTMPDIR="${GOTMPDIR:-"$srcdir"}"
export GOMODCACHE="${GOMODCACHE:-"$srcdir/go"}"
export GOFLAGS="$GOFLAGS -trimpath -mod=readonly -modcacherw"

build() {
	go build -ldflags "-X main.version=$pkgver" -o nabd ./cmd/nabd
}

check() {
	go test ./...
}

package() {
	install -Dm755 nabd "$pkgdir"/usr/bin/nabd
	install -Dm644 docs/nabd.1 "$pkgdir"/usr/share/man/man1/nabd.1
	install -Dm644 completions/nabd.bash "$pkgdir"/usr/share/bash-completion/completions/nabd
	install -Dm644 completions/_nabd "$pkgdir"/usr/share/zsh/site-functions/_nabd
	install -Dm644 completions/nabd.fish "$pkgdir"/usr/share/fish/vendor_completions.d/nabd.fish
	install -Dm644 -t "$pkgdir"/usr/share/doc/$pkgname README.md CHANGELOG.md docs/checks.md docs/output.md
}

sha512sums="
1e26ba64bb7f2351ca14fc0ccd8d630938dea4266437e469d5deb8c2509d02984220689b75025a45a0320870eac7ca5eb0eb72a3829278f9511dd462cdef5c04  nabd-0.1.0.tar.gz
"
